# Maintainer: Nabwin Saud

pkgname=mantra
pkgver=0.1.1
pkgrel=1
pkgdesc="Keyboard-first PostgreSQL terminal IDE"
arch=('x86_64')
url="https://github.com/Nabwinsaud/mantra"
license=('MIT')
depends=('gcc-libs' 'glibc' 'sqlite')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c3a9ca7ca3291492ee559e6447a9ed55e98af3525c877b3b8223bb5434dd51c2')

prepare() {
  cd "$pkgname-$pkgver"
  sed -i 's/rusqlite = { version = "0.37", features = \["bundled"\] }/rusqlite = "0.37"/' Cargo.toml
  grep -q '^rusqlite = "0.37"$' Cargo.toml
  cargo fetch --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  CARGO_PROFILE_RELEASE_LTO=false CARGO_TARGET_DIR=target cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  CARGO_TARGET_DIR=target cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/mantra "$pkgdir/usr/bin/mantra"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
